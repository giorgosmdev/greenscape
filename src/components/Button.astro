---
import type { HTMLAttributes } from "astro/types";

type BaseProps = {
  variant?: "primary" | "secondary" | "tertiary";
  label: string;
};

type LinkProps = BaseProps &
  Omit<HTMLAttributes<"a">, "type"> & {
    href: string;
    type?: never;
  };

type ButtonProps = BaseProps &
  Omit<HTMLAttributes<"button">, "type"> & {
    href?: never;
    type?: "button" | "submit" | "reset";
  };

type Props = LinkProps | ButtonProps;

const {
  href,
  variant = "primary",
  type = "button",
  label,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const attr = href ? { href } : { type };
---

<Tag
  {...attr}
  {...rest}
  class:list={["button", `button--${variant}`, "text-style-link", className]}
>
  <span class="button__label">{label}</span>
  {Astro.slots.has("icon") && (
    <span class="button__icon" aria-hidden="true">
      <slot name="icon" />
    </span>
  )}
</Tag>

<style is:global>
  @layer components {
    .button {
      padding: 1em 2em;
      display: inline-flex;
      gap: var(--space-step-2);
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-full);
      transition:
        background-color var(--transition-duration-hover)
          var(--transition-easing-hover),
        color var(--transition-duration-hover) var(--transition-easing-hover),
        box-shadow var(--transition-duration-hover)
          var(--transition-easing-hover);

      &:disabled {
        cursor: not-allowed;
      }
    }

    .button__icon {
      display: flex;
    }

    .button--primary {
      background-color: var(--button-primary-background);
      color: var(--button-primary-label);
      box-shadow: inset 0 0 0 var(--button-border-width)
        var(--button-primary-border);

      @media (hover: hover) {
        &:hover:not(:disabled) {
          background-color: var(--button-primary-background-hover);
          color: var(--button-primary-label-hover);
          box-shadow: inset 0 0 0 var(--button-border-width)
            var(--button-primary-border-hover);
        }
      }
    }

    .button--secondary {
      background-color: var(--button-secondary-background);
      color: var(--button-secondary-label);
      box-shadow: inset 0 0 0 var(--button-border-width)
        var(--button-secondary-border);

      @media (hover: hover) {
        &:hover:not(:disabled) {
          background-color: var(--button-secondary-background-hover);
          color: var(--button-secondary-label-hover);
          box-shadow: inset 0 0 0 var(--button-border-width)
            var(--button-secondary-border-hover);
        }
      }
    }

    .button--tertiary {
      background-color: var(--button-tertiary-background);
      color: var(--button-tertiary-label);
      box-shadow: inset 0 0 0 var(--button-border-width)
        var(--button-tertiary-border);

      @media (hover: hover) {
        &:hover:not(:disabled) {
          background-color: var(--button-tertiary-background-hover);
          color: var(--button-tertiary-label-hover);
          box-shadow: inset 0 0 0 var(--button-border-width)
            var(--button-tertiary-border-hover);
        }
      }
    }

    /* Fixes icon misalignment */
    .button--tertiary .button__icon {
      translate: 0 -0.08em;
    }
  }
</style>
