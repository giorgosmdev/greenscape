---
import Button from "./Button.astro";
---

<form action="#" method="post" class="contact-form">
  <div class="contact-form__field">
    <label for="contact-form-name" class="contact-form__label">
      Name (required)
    </label>
    <input
      type="text"
      id="contact-form-name"
      name="name"
      placeholder="John Doe"
      autocomplete="name"
      required
      class="contact-form__control"
    />
  </div>

  <div class="contact-form__field">
    <label for="contact-form-email" class="contact-form__label">
      Email (required)
    </label>
    <input
      type="email"
      id="contact-form-email"
      name="email"
      placeholder="example@email.com"
      autocomplete="email"
      required
      class="contact-form__control"
    />
  </div>

  <div class="contact-form__field">
    <label for="contact-form-service" class="contact-form__label">
      Select service (required)
    </label>
    <select
      id="contact-form-service"
      name="service"
      required
      class="contact-form__control"
    >
      <option value="">Please select a service</option>
      <option value="design">Design</option>
      <option value="development">Development</option>
      <option value="digital-marketing">Digital Marketing</option>
    </select>
  </div>

  <fieldset class="contact-form__fieldset">
    <legend class="contact-form__legend">Services</legend>

    <ul class="contact-form__options">
      <li class="contact-form__option">
        <input
          type="checkbox"
          name="services"
          value="design"
          id="contact-form-services-design"
          class="contact-form__checkbox"
        />
        <label
          for="contact-form-services-design"
          class="contact-form__option-label"
        >
          Design
        </label>
      </li>

      <li class="contact-form__option">
        <input
          type="checkbox"
          name="services"
          value="development"
          id="contact-form-services-development"
          class="contact-form__checkbox"
        />
        <label
          for="contact-form-services-development"
          class="contact-form__option-label"
        >
          Development
        </label>
      </li>

      <li class="contact-form__option">
        <input
          type="checkbox"
          name="services"
          value="digital-marketing"
          id="contact-form-services-digital-marketing"
          class="contact-form__checkbox"
        />
        <label
          for="contact-form-services-digital-marketing"
          class="contact-form__option-label"
        >
          Digital marketing
        </label>
      </li>
    </ul>
  </fieldset>

  <div class="contact-form__field">
    <label for="contact-form-message" class="contact-form__label">
      Message (required)
    </label>
    <textarea
      id="contact-form-message"
      name="message"
      rows="13"
      placeholder="Your message"
      required
      class="contact-form__control contact-form__control--textarea"
    ></textarea>
  </div>

  <Button
    type="submit"
    variant="primary"
    label="Send message"
    class="contact-form__button"
  />
</form>

<style is:global>
  @layer components {
    .contact-form {
      display: grid;
      row-gap: var(--space-flow-content);
    }

    .contact-form__field {
      display: flex;
      flex-direction: column;
      gap: var(--space-step-1);
    }

    .contact-form__option {
      display: flex;
      align-items: center;
      gap: var(--space-step-1);
    }

    .contact-form__checkbox {
      flex-shrink: 0;
      block-size: var(--size-16);
      inline-size: var(--size-16);
      accent-color: var(--color-text-primary);
    }

    .contact-form__control {
      padding: var(--space-step-2);
    }

    .contact-form__control--textarea {
      resize: vertical;
    }

    .contact-form__button {
      justify-self: start;
    }
  }
</style>
